# Public canonical origin; no trailing slash.
APP_ORIGIN=https://your-production-domain.example
APP_ENV=development

# Upstash Redis (server-only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (server-only)
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Web Push. The public key may be sent by a public configuration endpoint.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Server-only application secrets. Generate unique, high-entropy values.
SESSION_SECRET=
# Group codes are generated automatically and stored in Redis.
